# Copy this file to ~/.psvm_keys.env on the Kaggle machine and fill in the keys:
#   cp kaggle/keys.example.env ~/.psvm_keys.env && code ~/.psvm_keys.env
# Keep it in your home folder, NOT in /kaggle/working (that folder can end up in saved notebook output).

# --- VLM for the image reward model's preference labels (all Phase 2 runs) ---
# Free key: https://aistudio.google.com/apikey  (your limits: https://aistudio.google.com/rate-limit)
VLM_API_KEY=
VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VLM_MODEL=gemini-3.5-flash-lite
# Requests per minute to stay under (free tier). Set to your limit from the AI Studio rate-limit page.
VLM_RPM=10

# --- LLM for CoRe's reward-code refinement (only 'core' runs, ~16 calls per run) ---
# The paper used gpt-4.1-mini (OpenAI has no free tier). The same free Gemini key works here.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_RPM=5

# --- Kaggle API (only for saving/loading results as a private Kaggle dataset) ---
# KAGGLE_USERNAME: your Kaggle username (the name in your profile URL kaggle.com/<username>)
# KAGGLE_API_TOKEN: kaggle.com/settings/api -> "Generate New Token" -> copy the token it shows
#   (older accounts: "Create Legacy API Key" downloads kaggle.json; put its "key" in KAGGLE_KEY instead)
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KEY=
